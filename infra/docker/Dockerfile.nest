# syntax=docker/dockerfile:1.7
# NestJS services on Bun (api, worker).
#   docker build -f infra/docker/Dockerfile.nest --build-arg APP=@playora/api --build-arg APP_DIR=apps/api -t playora-api .
ARG BUN_VERSION=1.4.4

FROM oven/bun:${BUN_VERSION}-slim AS prune
WORKDIR /repo
COPY . .
ARG APP
RUN bunx turbo@2.11.10 prune ${APP} --docker

FROM oven/bun:${BUN_VERSION}-slim AS build
WORKDIR /repo
# Dependency layer: only package.json files + lockfile, so it is cached until deps change.
COPY --from=prune /repo/out/json/ .
RUN bun install --frozen-lockfile --ignore-scripts
COPY --from=prune /repo/out/full/ .
ARG APP_DIR
RUN cd ${APP_DIR} && bun run build
RUN rm -rf node_modules apps/*/node_modules packages/*/node_modules \
  && bun install --frozen-lockfile --production --ignore-scripts

FROM oven/bun:${BUN_VERSION}-slim AS runtime
ENV NODE_ENV=production
ARG APP_DIR
WORKDIR /app
# Workspace packages ship as TS source and are resolved at runtime (ADR-001).
COPY --from=build --chown=bun:bun /repo/node_modules ./node_modules
COPY --from=build --chown=bun:bun /repo/packages ./packages
COPY --from=build --chown=bun:bun /repo/package.json ./package.json
COPY --from=build --chown=bun:bun /repo/${APP_DIR} ./${APP_DIR}
WORKDIR /app/${APP_DIR}
USER bun
CMD ["bun", "dist/main.js"]
