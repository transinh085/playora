# =============================================================================
# Playora Production Environment Template
# =============================================================================
# Derived from `packages/env/src/index.ts` (`apiEnvSchema`, `workerEnvSchema`)
# and Next.js configs (`apps/{studio,play,web}/next.config.ts`).
#
# Copy to `/opt/playora/infra/env/.env.prod` on the production VM (chmod 600).
# NEVER commit real secrets to git. Variables marked [SECRET] must be replaced
# with high-entropy production values before starting the stack.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Container Registry & Reverse Proxy (Docker Compose + Caddy)
# -----------------------------------------------------------------------------
# GitHub org/user owning the GHCR packages (`ghcr.io/<GHCR_OWNER>/playora-<app>:<TAG>`).
GHCR_OWNER=playora
# Commit SHA deployed by `infra/scripts/deploy.sh <sha>`.
TAG=latest
# Email for Let's Encrypt / ZeroSSL ACME certificate notifications in Caddy.
ACME_EMAIL=ops@playora.vn

# -----------------------------------------------------------------------------
# 2. Runtime & Logging (Shared: api, worker, studio, play, web)
# -----------------------------------------------------------------------------
NODE_ENV=production
# Pino log level for `apps/api`: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# 3. Database & Valkey (Shared: migrate, api, worker)
# -----------------------------------------------------------------------------
# [SECRET] Managed PostgreSQL 17 connection string (with TLS & PITR enabled).
# Used by: `migrate`, `api`, `worker`, and `infra/scripts/{backup,restore}.sh`.
DATABASE_URL=postgres://playora:CHANGE_ME_STRONG_DB_PASSWORD@pg-prod.internal.example.vn:5432/playora?sslmode=require

# Max connections in the API Postgres pool (`apps/api`).
DATABASE_POOL_MAX=20

# Valkey connection URL on the internal compose network.
# Used by: `api` (throttler, cache, BullMQ producer), `worker` (BullMQ consumers).
REDIS_URL=redis://valkey:6379

# -----------------------------------------------------------------------------
# 4. API Server (`apps/api` — `apiEnvSchema`)
# -----------------------------------------------------------------------------
API_PORT=4000
API_PUBLIC_URL=https://api.playora.vn
PLAY_URL=https://play.playora.vn

# Comma-separated origins allowed to send credentials/cookies to the API.
STUDIO_ORIGINS=https://studio.playora.vn,https://play.playora.vn

# Parent domain for Better Auth session cookies so `studio.playora.vn` and
# `api.playora.vn` share organizer sessions (docs/engineering/architecture.md §8).
COOKIE_DOMAIN=.playora.vn

# Number of reverse-proxy hops in front of `apps/api` (Cloudflare + Caddy = 2).
TRUST_PROXY=2

# Per-IP requests/min for authenticated/general API endpoints.
RATE_LIMIT_PER_MIN=300
# Per-IP requests/min for public player endpoints (accommodates venue Wi-Fi NAT).
PUBLIC_RATE_LIMIT_PER_MIN=6000

# [SECRET] Signs organizer sessions in Better Auth (>= 32 chars).
# Generate with: `openssl rand -hex 32`
BETTER_AUTH_SECRET=CHANGE_ME_BETTER_AUTH_SECRET_AT_LEAST_32_CHARS_LONG

# [SECRET] Signs HMAC player session tokens (`@playora/core/session`, >= 32 chars).
# Rotating this logs out active players in running campaigns.
# Generate with: `openssl rand -hex 32`
PLAYER_SESSION_SECRET=CHANGE_ME_PLAYER_SESSION_SECRET_AT_LEAST_32_CHARS

# [SECRET] AES-256-GCM key for player PII (`players.phone_enc`, `@playora/core/pii`): base64 of 32 bytes.
# Losing it makes stored phones unreadable — keep a copy in the secret manager / password vault,
# never in the repo. The dev default is rejected at boot.
# Generate with: `openssl rand -base64 32`
PII_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES
# Id written in front of new ciphertexts (`v1:<iv>:<ct>:<tag>`). To rotate: set a new key and id,
# move the old one to PII_ENCRYPTION_PREVIOUS_KEYS (`v1:<base64>`) so existing rows still decrypt.
PII_ENCRYPTION_KEY_ID=v1
PII_ENCRYPTION_PREVIOUS_KEYS=
# [SECRET] HMAC-SHA256 key for lookup hashes (`players.phone_hash`): base64, >= 32 bytes.
# Do not rotate casually: every stored hash would have to be recomputed.
# Generate with: `openssl rand -base64 32`
PII_HMAC_KEY=CHANGE_ME_BASE64_32_BYTES

# -----------------------------------------------------------------------------
# 5. Object Storage — S3-Compatible (Shared: `api`, `worker` — `s3Env`)
# -----------------------------------------------------------------------------
# Production rejects dev defaults ("playora" / "playora123") at boot.
S3_ENDPOINT=https://s3.han01.fptcloud.com
S3_BUCKET=playora-prod-assets
# [SECRET] S3 access key ID for presigned uploads (`api`) and image processing (`worker`).
S3_ACCESS_KEY=CHANGE_ME_PROD_S3_ACCESS_KEY
# [SECRET] S3 secret access key.
S3_SECRET_KEY=CHANGE_ME_PROD_S3_SECRET_KEY

# -----------------------------------------------------------------------------
# 6. Transactional Email — SMTP (`apps/api` — invitations & magic links)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.example.vn
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM="Playora <noreply@playora.vn>"
# [SECRET] SMTP username (optional only if relay authenticates by IP).
SMTP_USER=CHANGE_ME_SMTP_USER
# [SECRET] SMTP password / API token.
SMTP_PASS=CHANGE_ME_SMTP_PASSWORD

# -----------------------------------------------------------------------------
# 7. Google OAuth (`apps/api` + `apps/studio` — optional, ORG-01)
# -----------------------------------------------------------------------------
# Leave both empty to hide the "Continue with Google" button on `/login`.
GOOGLE_CLIENT_ID=
# [SECRET] Google OAuth client secret.
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# 8. Background Worker (`apps/worker` — `workerEnvSchema`)
# -----------------------------------------------------------------------------
# Internal HTTP liveness port checked by Docker healthcheck (`apps/worker/src/main.ts`).
WORKER_HEALTH_PORT=4002

# -----------------------------------------------------------------------------
# 9. Next.js Apps (`apps/studio`, `apps/play`, `apps/web`)
# -----------------------------------------------------------------------------
# Note: `NEXT_PUBLIC_*` variables are also passed as Docker build-args in CI
# because Next.js inlines them into client bundles at build time.
NEXT_PUBLIC_API_URL=https://api.playora.vn
NEXT_PUBLIC_PLAY_URL=https://play.playora.vn
# Allowed parent origins for `play.playora.vn/preview` postMessage bridge.
NEXT_PUBLIC_STUDIO_ORIGINS=https://studio.playora.vn
# Set to 0 in production to disable experimental dev-only Builder Lab toggles.
NEXT_PUBLIC_STUDIO_LABS=0

# -----------------------------------------------------------------------------
# 10. Database Backup & Restore (`infra/scripts/backup.sh`, `restore.sh`)
# -----------------------------------------------------------------------------
# S3-compatible bucket for logical `pg_dump` backups (used alongside or when
# the DB provider does not include managed PITR).
BACKUP_S3_ENDPOINT=https://s3.han01.fptcloud.com
BACKUP_S3_BUCKET=playora-prod-backups
BACKUP_S3_PREFIX=postgres
BACKUP_RETENTION_DAYS=30
AWS_DEFAULT_REGION=auto
# [SECRET] Credentials with write/delete access to `BACKUP_S3_BUCKET`.
AWS_ACCESS_KEY_ID=CHANGE_ME_BACKUP_S3_ACCESS_KEY
# [SECRET] Secret key for backup bucket.
AWS_SECRET_ACCESS_KEY=CHANGE_ME_BACKUP_S3_SECRET_KEY
