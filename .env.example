# Copy to .env at the repo root. Apps load it via `bun --env-file=../../.env` (Next.js apps via next.config).
NODE_ENV=development

DATABASE_URL=postgres://playora:playora@localhost:54329/playora
REDIS_URL=redis://localhost:63799

API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
PLAY_URL=http://localhost:3002
STUDIO_ORIGINS=http://localhost:3001,http://localhost:3002
# Generate your own: openssl rand -hex 32
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
# Signs and verifies player session tokens (API issues and verifies).
PLAYER_SESSION_SECRET=dev-only-player-session-secret-0123456789abcdef
WORKER_HEALTH_PORT=4002

# Public URLs used by the Next.js apps
NEXT_PUBLIC_API_URL=http://localhost:4000

# S3 / MinIO (In production, real credentials are required; dev defaults "playora"/"playora123" are rejected by env schema)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=playora-dev
S3_ACCESS_KEY=playora
S3_SECRET_KEY=playora123

# SMTP (Mailpit in dev: SMTP :1025, web UI http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM="Playora <noreply@playora.local>"

# Optional Google OAuth (ORG-01). Leave empty to hide "Continue with Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
