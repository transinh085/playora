{
  "name": "@playora/realtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/main.ts",
    "start": "bun --env-file=../../.env dist/main.js",
    "build": "bun build src/main.ts --target=bun --outdir=dist --sourcemap=linked --packages=external",
    "typecheck": "tsc --noEmit",
    "test": "bun --env-file=../../.env test"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/platform-socket.io": "12.2.0",
    "@nestjs/websockets": "12.2.0",
    "@playora/contracts": "workspace:*",
    "@playora/core": "workspace:*",
    "@playora/db": "workspace:*",
    "@playora/env": "workspace:*",
    "@playora/game-sdk": "workspace:*",
    "@playora/templates": "workspace:*",
    "drizzle-orm": "0.45.4",
    "ioredis": "6.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4",
    "uuidv7": "1.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playora/realtime-client": "workspace:*",
    "@playora/tsconfig": "workspace:*",
    "socket.io-client": "4.8.4"
  }
}
