{
  "name": "@playora/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/main.ts",
    "start": "bun --env-file=../../.env dist/main.js",
    "build": "bun build src/main.ts --target=bun --outdir=dist --sourcemap=linked --packages=external",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@playora/env": "workspace:*",
    "@playora/jobs": "workspace:*",
    "bullmq": "6.4.0",
    "ioredis": "6.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@playora/tsconfig": "workspace:*"
  }
}
