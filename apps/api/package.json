{
  "name": "@playora/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/main.ts",
    "start": "bun --env-file=../../.env dist/main.js",
    "build": "bun build src/main.ts --target=bun --outdir=dist --sourcemap=linked --packages=external",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@playora/auth": "workspace:*",
    "@playora/contracts": "workspace:*",
    "@playora/db": "workspace:*",
    "@playora/env": "workspace:*",
    "better-auth": "1.7.12",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "ioredis": "6.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.2.0",
    "@playora/tsconfig": "workspace:*",
    "@types/express": "5.0.6"
  }
}
