    "@playora/auth": "workspace:*",
    "@playora/contracts": "workspace:*",
    "@playora/core": "workspace:*",
    "@playora/db": "workspace:*",
    "@playora/env": "workspace:*",
    "@playora/game-sdk": "workspace:*",
    "@playora/jobs": "workspace:*",
    "@playora/templates": "workspace:*",
    "better-auth": "1.7.12",
    "drizzle-orm": "0.45.4",
    "exceljs": "4.4.0",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "nestjs-pino": "5.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuidv7": "1.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.2.0",
    "@playora/api-client": "workspace:*",
    "@playora/tsconfig": "workspace:*",
    "@types/express": "5.0.6",
    "pino-pretty": "13.2.0"
