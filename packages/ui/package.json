{
  "name": "@playora/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./components": "./src/components/index.ts",
    "./components/*": [
      "./src/components/*.tsx",
      "./src/components/*.ts"
    ],
    "./utils/*": [
      "./src/utils/*.ts",
      "./src/utils/*.tsx"
    ],
    "./hooks/*": [
      "./src/hooks/*.ts",
      "./src/hooks/*.tsx"
    ],
    "./styles/*": "./src/styles/*",
    "./auto-form": "./src/auto-form/index.tsx",
    "./auto-form/*": "./src/auto-form/*.tsx",
    "./campaign": "./src/campaign/index.ts",
    "./form": "./src/form/index.ts",
    "./form/*": "./src/form/*.ts",
    "./game/*": "./src/game/*.tsx",
    "./icons": "./src/icons/index.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./providers": "./src/providers/index.tsx",
    "./providers/*": "./src/providers/*.tsx",
    "./styles.css": "./src/styles.css",
    "./theme": "./src/theme/index.ts",
    "./theme/*": "./src/theme/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "next-themes": "^0.4.0"
  },
  "devDependencies": {
    "@playora/tsconfig": "workspace:*",
    "@types/bun": "1.4.4",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "dependencies": {
    "@hookform/resolvers": "6.0.0",
    "@hugeicons/core-free-icons": "4.4.0",
    "@hugeicons/react": "1.1.10",
    "@internationalized/date": "3.12.4",
    "@playora/contracts": "workspace:*",
    "@remixicon/react": "4.9.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-table": "8.21.3",
    "motion": "12.43.0",
    "qrcode": "1.5.4",
    "react-aria-components": "1.22.1",
    "react-hook-form": "7.90.0",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7"
  }
}
